{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "entry-server.tsx",
    "vite.config.ts",
    "components/**/*.tsx",
    "data/**/*.ts",
    "pages/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", ".prerender", "DinoClaw"]
}
